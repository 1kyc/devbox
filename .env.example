# Copy to .env and edit. .env is gitignored.
#
#   cp .env.example .env

# The ONE folder the box can see. Everything outside it is unreachable, so
# choose deliberately: agents can write anything in here.
#
# Must be an absolute Linux path, and must be on the Linux filesystem — a
# /mnt/c/... path crosses Docker Desktop's filesystem bridge, which is slow,
# watches unreliably, and hands you CRLF surprises.
PLAYGROUND=/home/kyc/dev

# The container user. Match your host account so bind-mounted files come out
# owned by you: `id -un`, `id -u`, `id -g`.
DEVBOX_USER=kyc
DEVBOX_UID=1000
DEVBOX_GID=1000

# Branches the pre-push guard refuses to push to, space separated.
# Set to "" to disable it entirely.
DEVBOX_PROTECTED_BRANCHES=main master

# Let agents merge pull requests. Off by default: opening a PR should not be one
# autonomous step away from merging it.
DEVBOX_ALLOW_MERGE=0

# Start even when the GitHub token reaches repositories that are not checked out
# in the playground. This turns off the check that keeps token scope from
# drifting outward over time — see DESIGN.md before setting it.
DEVBOX_ALLOW_BROAD_TOKEN=0

# --- versions ---------------------------------------------------------------
# Defaults are rolling: a rebuild installs whatever is current. Pin for a
# reproducible image.
# CLAUDE_VERSION=stable
# CODEX_VERSION=latest
# PYTHON_VERSION=3.13
# NODE_VERSION=lts-latest

# --- misc -------------------------------------------------------------------
# DEVBOX_NAME=devbox
# DEVBOX_PIDS_LIMIT=4096      # shared by every agent running in parallel
# CODEX_LOGIN_PORT=1455

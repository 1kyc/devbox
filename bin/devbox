#!/usr/bin/env bash
# devbox — a thin wrapper over `docker compose` for the box.
#
# Exists mostly to stop you running compose from the wrong place: PLAYGROUND is
# a Linux absolute path, so every command has to run from inside WSL with this
# repo's compose.yaml. Symlink it onto your PATH:
#
#   ln -s ~/devbox/bin/devbox ~/.local/bin/devbox
#
#   devbox                shell into the box (same as `devbox shell`)
#   devbox cc | cx        start Claude Code / Codex directly
#   devbox up | down      start / stop it
#   devbox rebuild        rebuild the image and recreate the container
#   devbox logs           what setup.sh said at boot (start here when it fails)
#   devbox audit          re-run the guard and host-bleed checks
#   devbox status         is it up, and how long has it been up
#
# Anything else is passed straight through to `docker compose`.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$REPO"

if [ ! -f .env ]; then
  echo "devbox: no .env here. Start with:" >&2
  echo "    cp $REPO/.env.example $REPO/.env   # then edit PLAYGROUND" >&2
  exit 1
fi

# `exec` needs a real executable, so every dispatch below spells out
# `docker compose`. An earlier version wrapped it in a shell function and
# exec'd that, which fails with "exec: dc: not found" on every subcommand.
# tests/launcher.sh exists because of it.

# The box is only useful when it is up; shelling into a stopped box should start
# it rather than erroring at you.
#
# A name query, not `compose ps` + `docker inspect`. Both of those serialize an
# existing container's full inspect payload and measure ~3 s EACH on Docker
# Desktop, so the old pair cost 6.1 s in front of every interactive command —
# far more than everything setup.sh does at boot. This is ~30 ms.
#
# By CONTAINER NAME, which compose.yaml sets explicitly, not by compose project
# label: `${PWD##*/}` is merely compose's *default* project name, and
# COMPOSE_PROJECT_NAME, a top-level `name:`, or `-p` all override it. Guessing
# it wrong both restarted a running custom-named box and — worse — found some
# other project's default-named container and skipped starting this one.
NAME="$(sed -n 's/^DEVBOX_NAME=[[:space:]]*//p' .env | tr -d "\"' " | head -1)"
NAME="${NAME:-devbox}"

ensure_up() {
  [ -n "$(docker container ls -q -f name="^${NAME}\$" -f status=running 2>/dev/null)" ] \
    || docker compose up -d
}

# `exec docker compose` stays spelled out inside the function, so this cannot
# regress into the `exec dc` mistake above.
in_box() { ensure_up; exec docker compose exec devbox "$@"; }

cmd="${1:-shell}"
[ $# -gt 0 ] && shift

case "$cmd" in
  shell|sh) in_box bash -l ;;
  cc)       in_box bash -lc 'claude --dangerously-skip-permissions "$@"' _ "$@" ;;
  cx)       in_box bash -lc 'codex --dangerously-bypass-approvals-and-sandbox "$@"' _ "$@" ;;
  run)      in_box bash -lc "$*" ;;
  audit)    in_box /usr/local/share/devbox/setup.sh --audit ;;
  up)       exec docker compose up -d "$@" ;;
  down)     exec docker compose down "$@" ;;
  logs)     exec docker compose logs "$@" devbox ;;
  status)   exec docker compose ps ;;
  rebuild)  docker compose build --pull "$@" && exec docker compose up -d --force-recreate ;;
  *)        exec docker compose "$cmd" "$@" ;;
esac
